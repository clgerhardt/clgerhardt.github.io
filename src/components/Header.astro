---
import ThemeToggle from "./ThemeToggle";

const links = [
  { href: "/games", label: "Games" },
  { href: "/projects", label: "Projects" },
  { href: "/art", label: "Art" },
  { href: "/experience", label: "Experience" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<header class="sticky top-0 z-40 border-b-4 border-foreground bg-background">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-3">
    <a href="/" class="order-1 font-heading text-sm text-primary hover:text-accent" aria-label="Home">
      CG<span class="animate-pulse">_</span>
    </a>
    <nav aria-label="Main" class="order-3 flex w-full flex-wrap items-center justify-between sm:order-2 sm:w-auto sm:justify-start sm:gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href || path.startsWith(`${l.href}/`) ? "page" : undefined}
            class="px-2 py-1 text-lg hover:bg-muted aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="order-2 sm:order-3">
      <ThemeToggle client:load />
    </div>
  </div>
</header>
