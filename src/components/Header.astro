---
import ThemeToggle from "./ThemeToggle";

const links = [
  { href: "/games", label: "Games" },
  { href: "/projects", label: "Projects" },
  { href: "/art", label: "Art" },
  { href: "/experience", label: "Experience" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<header class="sticky top-0 z-40 border-b-4 border-foreground bg-background">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="font-heading text-sm text-primary hover:text-accent" aria-label="Home">
      CG<span class="animate-pulse">_</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href || path.startsWith(`${l.href}/`) ? "page" : undefined}
            class="px-2 py-1 text-lg hover:bg-muted aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
          >
            {l.label}
          </a>
        ))
      }
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
