---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { games } from "../data/games";
---

<Base title="Games" description="Games and game projects by Christian Gerhardt.">
  <h1 class="text-2xl">Games</h1>
  <p class="mt-3 text-muted-foreground">Things I've made, remade, or am still making.</p>
  <ul class="mt-8 grid gap-6 sm:grid-cols-2">
    {games.map((g) => <ProjectCard {...g} />)}
  </ul>
</Base>
