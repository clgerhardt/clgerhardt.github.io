---
import Base from "../../layouts/Base.astro";
import { experience, type Job } from "../../data/experience";

export function getStaticPaths() {
  return experience.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props as { job: Job };
---

<Base title={job.company} description={`Experience at ${job.company}.`}>
  <a href="/experience" class="text-base text-muted-foreground hover:text-primary">&#9664; All experience</a>
  <section class="pixel-box mt-6 p-5 md:p-6">
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-xl">
        <a href={job.url} target="_blank" rel="noreferrer" class="hover:text-primary">{job.company}</a>
      </h1>
      <p class="text-base text-muted-foreground">{job.period}</p>
    </header>
    <dl class="mt-4 space-y-1 text-base">
      {
        job.stack.map((s) => (
          <div>
            <dt class="inline font-semibold text-primary">{s.label ? `${s.label}: ` : "Stack: "}</dt>
            <dd class="inline">{s.items}</dd>
          </div>
        ))
      }
    </dl>
    <ol class="mt-6 space-y-8 border-l-4 border-foreground pl-5">
      {
        job.roles.map((r) => (
          <li class="relative">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-sm leading-relaxed">{r.title}</h2>
              <p class="text-base text-muted-foreground">{r.period}</p>
            </div>
            {r.summary && <p class="mt-3">{r.summary}</p>}
            {
              r.groups.map((g) => (
                <div class="mt-4">
                  <h3 class="font-sans text-lg font-semibold tracking-normal text-secondary">{g.heading}</h3>
                  <ul class="mt-1 list-['▪'] space-y-1 pl-5 marker:text-primary [&>li]:pl-2">
                    {g.points.map((p) => <li>{p}</li>)}
                  </ul>
                </div>
              ))
            }
          </li>
        ))
      }
    </ol>
  </section>
</Base>
