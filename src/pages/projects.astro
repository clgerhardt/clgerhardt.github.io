---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Base title="Projects" description="Software projects by Christian Gerhardt.">
  <h1 class="text-2xl">Projects</h1>
  <p class="mt-3 text-muted-foreground">Websites, tools, and extensions.</p>
  <ul class="mt-8 grid gap-6 sm:grid-cols-2">
    {projects.map((p) => <ProjectCard {...p} />)}
  </ul>
</Base>
